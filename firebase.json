{
  "hosting": {
    "site": "lucio42",
    "public": "dist",
    "predeploy": ["node scripts/build-static.mjs"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/index.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/version.json",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
